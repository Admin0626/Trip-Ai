# Local Git metadata from the former split repositories (kept as backups).
trip-server/.git-legacy/
trip-web/.git-legacy/
docs/.git-legacy/
.workbuddy/

# Build and dependency output
trip-server/target/
trip-web/node_modules/
trip-web/dist/
**/target/
**/node_modules/
**/dist/

# IDE and local runtime files
.idea/
.vscode/
*.iml
*.log
*.local
uploads/

# Local test dumps and credentials
token*.txt
# Only exclude scratch response dumps in the workspace root.
/*.json
__pycache__/
*.pyc

# Test evidence is intentionally tracked; it is generated JSON under docs/dev/evidence.
!docs/dev/evidence/**/*.json
